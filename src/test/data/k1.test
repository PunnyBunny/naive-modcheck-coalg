// k1: simple 2-state K model. CTL formulas translated to mu-calculus. 
K ; nu x1 . ([@1]p  & [@2][a][] x1) ; x ; false
K ; nu x1 . ([@1]p  & [@2][a]<> x1) ; x ; false
K ; mu x1 . ([@1]p  | [@2][a]<> x1) ; x ; true
K ; nu x1 . ([@1]!p & [@2][a]<> x1) ; x ; true
K ; nu x1 . ([@1]!p & [@2][a][] x1) ; x ; false
