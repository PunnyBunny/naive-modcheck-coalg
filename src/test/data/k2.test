// k2: 2-state K model with p1/p2. Line 1 is direct mu-calculus; rest are CTL translations. 
K ; nu x2 . (mu x1 . (([@1]p1 & [@2][a]<> x1) | ([@1]p2 & [@2][a][] x2))) ; x ; true
K ; nu z . ([@1]p1 & [@2][a]<> z) ; x ; true
K ; nu z . ([@1]p2 & [@2][a]<> z) ; y ; true
K ; nu z . (([@1]p1 | [@1]p2) & [@2][a][] z) ; x ; true
K ; nu z . (([@1]p1 | [@1]p2) & [@2][a][] z) ; y ; true
K ; mu z . (([@1]p1 | [@1]p2) | [@2][a][] z) ; x ; true
K ; mu z . (([@1]p1 & [@1]p2) | [@2][a][] z) ; x ; false
K ; nu z2 . ((mu z1 . (([@1]p1 | [@1]p2) | [@2][a][] z1)) & [@2][a][] z2) ; x ; true
